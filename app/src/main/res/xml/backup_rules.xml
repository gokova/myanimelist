<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The Tink keyset cannot be restored without its Android Keystore master key. -->
    <exclude domain="sharedpref" path="auth_prefs.xml" />
    <!-- OAuth tokens and PKCE state are encrypted with that keyset. -->
    <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
</full-backup-content>
